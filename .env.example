# CreateOS Sandbox — use API key from dashboard OR OAuth access token from `createos login`
CREATEOS_SANDBOX_API_KEY=
CREATEOS_SANDBOX_ACCESS_TOKEN=
# Default control plane (CLI uses this; region may still be eu)
CREATEOS_SANDBOX_BASE_URL=https://api.sb.createos.sh

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# ProofPay server signing secret (generate: openssl rand -hex 32)
PROOFPAY_RECEIPT_SECRET=

# Optional: default bounty amount in cents
PROOFPAY_BOUNTY_CENTS=10000
